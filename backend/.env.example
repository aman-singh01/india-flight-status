# ---- India Domestic Flight Tracker config ----
# Copy to .env and edit.

# Comma-separated ingest sources, evaluated left -> right (later source wins on conflict).
#   adsblol                               public api.adsb.lol grid poll (default)
#   demo                                  synthetic domestic traffic, no network needed
#   readsb:http://<feeder-ip>/tar1090/data/aircraft.json   your own RTL-SDR feeder
# Example production line once your feeders are up:
#   SOURCES=readsb:http://192.168.1.50/tar1090/data/aircraft.json,readsb:http://192.168.1.51/tar1090/data/aircraft.json
SOURCES=adsblol

# Seconds between ingest polls. adsblol self-paces its grid sweep (~25s); this
# just gates the WebSocket push cadence to the browser.
POLL_INTERVAL=5

# Drop an aircraft from the live map if not seen for this many seconds.
STALE_TTL=150

# Include VT- registered general aviation / bizjets that stay inside India (no airline callsign).
INCLUDE_GA=false

# Persist position history to SQLite (enables longer track trails + stats after restart).
PERSIST=true
DB_PATH=flights.db

# Max positions kept in memory per aircraft (900 @ 5s poll ~= 75 min of trail).
TRACK_MAXLEN=900

# CORS (comma-separated, or *)
CORS_ORIGINS=*

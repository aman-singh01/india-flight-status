# ---- India Domestic Flight Tracker config ----
# Copy to .env and edit.

# Comma-separated ingest sources -- all are polled and UNIONED (deduped by ICAO
# hex; a later source wins on conflict).
#   adsblol         public api.adsb.lol grid poll -- best free India coverage, but
#                   rate-limits hard (~half the grid 429s per sweep)
#   adsbfi          public opendata.adsb.fi grid poll -- gentler limit, but sparse
#                   coverage over India today; fills the odd gap
#   opensky         OpenSky Network -- one bbox call, a different feeder network +
#                   MLAT, so it adds aircraft the grid misses. The India bbox costs
#                   4 credits/call; anonymous = 400 credits/day PER IP (a shared host
#                   exhausts it), registered = 4000/day. Needs OAuth2 credentials below.
#   demo            synthetic domestic traffic, no network needed
#   readsb:http://<feeder-ip>/tar1090/data/aircraft.json   your own RTL-SDR feeder
# Production line once your feeders are up (near-complete local coverage, no limits):
#   SOURCES=readsb:http://192.168.1.50/tar1090/data/aircraft.json,readsb:http://192.168.1.51/tar1090/data/aircraft.json
SOURCES=adsblol,adsbfi,opensky

# OpenSky OAuth2 client credentials (opensky-network.org -> My OpenSky -> Account ->
# API client). Basic username/password auth is no longer accepted. Blank = anonymous.
# With credentials the source polls every 100 s (4000 credits/day / 4 per call).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Seconds between ingest polls. adsblol self-paces its grid sweep (~25s); this
# just gates the WebSocket push cadence to the browser.
POLL_INTERVAL=5

# Retain an aircraft this many seconds after its last report (survives a sweep
# where its region was rate-limited).
STALE_TTL=210

# Include VT- registered general aviation / bizjets that stay inside India (no airline callsign).
INCLUDE_GA=false

# Persist position history to SQLite (enables longer track trails + stats after restart).
PERSIST=true
DB_PATH=flights.db

# Max positions kept in memory per aircraft (900 @ 5s poll ~= 75 min of trail).
TRACK_MAXLEN=900

# CORS (comma-separated, or *)
CORS_ORIGINS=*

# ---- Routes ----
# Origin/destination for every flight comes from the free api.adsbdb.com routeset
# (no key). Optionally add a keyed schedule API for scheduled/estimated times,
# gate and delay. Off unless both PROVIDER and API_KEY are set.
#   SCHEDULE_PROVIDER=aerodatabox   key = RapidAPI "X-RapidAPI-Key" (Basic = free, tiny cap)
#   SCHEDULE_PROVIDER=flightaware   key = FlightAware AeroAPI key (pay-per-query, great coverage)
SCHEDULE_PROVIDER=
SCHEDULE_API_KEY=
# SCHEDULE_ALL=false -> query the API only for callsigns adsbdb can't resolve.
# SCHEDULE_ALL=true  -> query it for EVERY flight (scheduled times / gate / delay
#   for all), refreshed every SCHEDULE_REFRESH sec. Full coverage is thousands of
#   calls/day; SCHEDULE_MAX_PER_DAY is the hard stop -- set it to your plan.
SCHEDULE_ALL=false
SCHEDULE_REFRESH=1800
SCHEDULE_MAX_PER_HOUR=30
SCHEDULE_MAX_PER_DAY=300
SCHEDULE_SPACING=4.0
# Where the route cache is persisted so restarts don't re-spend the quota.
ROUTE_CACHE_PATH=route_cache.json

# ---- Airport FIDS ----
# Scrape airport flight-information boards so scheduled flights show even with no
# transponder in view (grounded / boarding / delayed / cancelled). Only Delhi is
# implemented -- its dial-api is open; the other big airports are bot-walled.
# Set FIDS_SOURCES= (empty) to turn the schedule board off.
FIDS_SOURCES=del
FIDS_REFRESH=200
FIDS_WINDOW_BEHIND=2
FIDS_WINDOW_AHEAD=10
# Set a random token to enable POST /ingest/fids, so a scraper run elsewhere
# can push airports the app cannot scrape itself (see tools/fids_push.py). Pushed
# rows expire after FIDS_PUSH_TTL seconds without a refresh.
FIDS_INGEST_TOKEN=
FIDS_PUSH_TTL=600

# Observed takeoffs / landings (detected from the ADS-B stream) are kept this long.
# In memory, so a restart empties them.
MOVEMENTS_KEEP_HOURS=12
